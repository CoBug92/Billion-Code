{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billion-code.example/schemas/manifest-v1.schema.json",
  "title": "BillionCode Content Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestRevision",
    "minimumReaderBuild",
    "publishedAt",
    "dataset",
    "mediaOrigin",
    "allowedHosts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestRevision": { "type": "integer", "minimum": 1 },
    "minimumReaderBuild": { "type": "integer", "minimum": 1 },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentVersion", "url", "byteSize", "sha256"],
      "properties": {
        "contentVersion": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\+[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+/[a-f0-9]{64}\\.json$"
        },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "mediaOrigin": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+/?$"
    },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
      }
    }
  }
}
