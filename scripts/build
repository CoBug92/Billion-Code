#!/bin/sh

set -eu
. "$(dirname -- "$0")/common.sh"

if [ ! -d "$PROJECT_DIRECTORY/$PROJECT_NAME.xcodeproj" ]; then
    "$SCRIPTS_DIRECTORY/generate"
fi

destination="${CI_BUILD_DESTINATION:-generic/platform=iOS Simulator}"

exec xcodebuild \
    -project "$PROJECT_DIRECTORY/$PROJECT_NAME.xcodeproj" \
    -scheme "$TARGET_NAME" \
    -configuration Debug \
    -destination "$destination" \
    -derivedDataPath "$PROJECT_DIRECTORY/.DerivedData" \
    CODE_SIGNING_ALLOWED=NO \
    build

