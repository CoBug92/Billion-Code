#!/bin/sh

set -eu
SCRIPTS_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. "$SCRIPTS_DIRECTORY/common.sh"

actual_version="$(swiftgen --version | awk '{print $2}' | sed 's/^v//')"
if [ "$actual_version" != "6.6.3" ]; then
    printf 'Expected SwiftGen 6.6.3, found %s\n' "$actual_version" >&2
    exit 1
fi

cd "$SCRIPTS_DIRECTORY/swiftgen"
exec swiftgen config run --config swiftgen.yml
